# Dify Docker .env — tuned for Xeon W-2235 (6C/12T), 251GB RAM, NVMe SSD
# Date: 2025-10-18

# ---------- Embedding server mapping ----------
# Helpful host mapping for your Sugon embedding server
EMBEDDING_HOST_1=c-1968602971252453378.qdai.scnet.cn
EMBEDDING_HOST_IP_1=112.6.197.30
# Your OpenAI-compatible embedding API endpoint and key
OPENAI_API_BASE=http://c-1968602971252453378.qdai.scnet.cn:8000/v1
OPENAI_API_KEY=REPLACE_WITH_YOUR_KEY

# ---------- Storage on SSD ----------
# Put app and vector data on SSD/NVMe
APP_STORAGE_HOST_PATH=/home/gw/opt/dify-ssd/app_storage
QDRANT_DATA_HOST_PATH=/home/gw/opt/dify-ssd/qdrant

# ---------- Database ----------
# Explicit DB vars to avoid compose warnings
DB_USERNAME=postgres
DB_PASSWORD=difyai123456
DB_DATABASE=dify
POSTGRES_MAX_CONNECTIONS=300
POSTGRES_SHARED_BUFFERS=16GB
POSTGRES_WORK_MEM=64MB
POSTGRES_MAINTENANCE_WORK_MEM=4GB
POSTGRES_EFFECTIVE_CACHE_SIZE=80GB

# ---------- Redis ----------
REDIS_PASSWORD=difyai123456

# ---------- Web / Nginx ----------
NGINX_SERVER_NAME=localhost
EXPOSE_NGINX_PORT=80
EXPOSE_NGINX_SSL_PORT=443

# Avoid certbot variable warnings (leave empty if unused)
CERTBOT_EMAIL=
CERTBOT_DOMAIN=

# ---------- Dify app URLs (adjust if reverse-proxying externally) ----------
CONSOLE_API_URL=http://localhost/v1
SERVICE_API_URL=http://localhost/v1
APP_API_URL=http://localhost/v1
APP_WEB_URL=http://localhost

# ---------- Files service URLs ----------
# Public base URL used to generate signed file preview/download links.
# Do NOT include trailing slash or /files; Dify will append /files internally.
# Per your requirement and reference env, use internal service URL directly:
FILES_URL=http://api:5001

# Internal URL for plugin daemon and intra-container access to files service.
# Use the api service inside the Docker network.
INTERNAL_FILES_URL=http://api:5001

# Signed URL expiration in seconds (increase a bit to avoid timeouts on slow networks)
FILES_ACCESS_TIMEOUT=900

# ---------- Vector store ----------
VECTOR_STORE=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_CLIENT_TIMEOUT=60
QDRANT_GRPC_ENABLED=false

# ---------- Indexing ----------
INDEXING_MAX_SEGMENTATION_TOKENS_LENGTH=6000

# ---------- Monitoring ----------
ENABLE_DATASETS_QUEUE_MONITOR=true
QUEUE_MONITOR_INTERVAL=15
ENABLE_CLEAN_EMBEDDING_CACHE_TASK=true
CLEAN_EMBEDDING_CACHE_DAY_SETTING=7

# ---------- Optional: raise API concurrency ----------
SERVER_WORKER_AMOUNT=2
SERVER_WORKER_CONNECTIONS=500
LOG_LEVEL=INFO

# ---------- Profiles ----------
# Start with: docker compose --profile qdrant up -d
