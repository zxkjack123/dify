{
    "default_warn_within_days": 7,
    "default_ttl_days": 90,
    "secrets": {
        "OPENAI_API_KEY": {
            "description": "Primary LLM provider key. Rotate every 60 days and alert two weeks in advance.",
            "required": true,
            "warn_within_days": 14,
            "default_ttl_days": 60,
            "max_ttl_days": 120,
            "scopes": [
                "llm",
                "default"
            ]
        },
        "WORKFLOW_AUTOMATION_TOKEN": {
            "description": "Automation CLI service token scoped to workflow import permissions only.",
            "required": true,
            "warn_within_days": 10,
            "default_ttl_days": 45,
            "max_ttl_days": 90,
            "scopes": [
                "automation",
                "cli"
            ]
        }
    }
}